VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Telegram Bot Token must be stored as a Supabase Edge Function secret, not a Vite frontend env.
# supabase secrets set SPD_SERVICE_TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Audit Logs export settings must be configured on the server/Edge Function side only.
# Do not prefix these with VITE_ and do not call Apps Script directly from frontend code.
AUDIT_LOG_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbw7LP0jGOLBZn_Oof2Vvp3ZiFzMIGBO-IhrYwYcB33kTBf7634L5leKb2AOrsft_cEx/exec
AUDIT_LOG_EXPORT_SECRET=replace-with-a-long-random-secret
AUDIT_LOG_EXPORT_CRON_SECRET=replace-with-another-long-random-secret
AUDIT_LOG_NOTIFY_EMAILS=admin@example.com,security@example.com